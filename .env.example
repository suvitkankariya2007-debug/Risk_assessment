# ─────────────────────────────────────────────────────────────────────────────
# CyberRiskIQ Copilot — Environment Variables Template
# Copy this file to .env and fill in your API keys.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Primary LLM (Google Gemini) ──────────────────────────────────────────────
# Free tier: 20 requests/day for gemini-3.6-flash
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# ── Fallback LLM (Groq — Recommended, Free Tier) ─────────────────────────────
# The system auto-falls back to Groq if Gemini is rate-limited.
# Get key: https://console.groq.com/keys
GROQ_API_KEY="gsk_your-groq-api-key-here"

# ── Optional: Force a specific LLM provider ──────────────────────────────────
# Leave blank to use auto-fallback chain: Gemini → Groq → OpenAI → Deterministic
# Options: gemini | groq | openai | anthropic
# LLM_PROVIDER=""

# ── Optional: OpenAI (only needed if you prefer GPT over Groq) ───────────────
# OPENAI_API_KEY=""
